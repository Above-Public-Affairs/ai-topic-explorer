# AI Topic Explorer: environment variables.
# Production values live on the Railway service ("AI Topic Explorer" project,
# `ai-topic-explorer` service). Never commit real values.

# ── Email (SendGrid) ────────────────────────────────────────────────────────
# Same SendGrid account as Above's other tools (Agenda Briefings, Development
# Email Updates, the Error Reporter digest).
# Key: 1Password → Development → "API Key - SendGrid General" (field `credential`).
SENDGRID_API_KEY=
# Any address on abovepublicaffairs.com (domain-authenticated in SendGrid).
SENDGRID_FROM=topic-explorer@abovepublicaffairs.com
# Optional. Display name; defaults to "AI Topic Explorer".
SENDGRID_FROM_NAME=AI Topic Explorer
# Optional. Where replies go; defaults to joshua@abovepublicaffairs.com.
REPLY_TO=

# ── Alerts (task 5.2) ───────────────────────────────────────────────────────
# Off unless "true": alerts are stored as suppressed and nothing is sent.
# Set on the services that run snapshots (weekly-snapshots, event-watcher,
# model-watcher). Turning it on for real is task 8.2.
ALERTS_ENABLED=false
# Optional. Comma-separated; defaults to joshua@abovepublicaffairs.com.
ALERT_RECIPIENTS=
